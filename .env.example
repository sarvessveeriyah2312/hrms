# Backend
DB_URL=jdbc:postgresql://localhost:5432/hrms
DB_USER=hrms_app
DB_PASSWORD=hrms_app
REDIS_HOST=localhost
FIREBASE_ENABLED=false
FIREBASE_PROJECT_ID=
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/outside/repo/service-account.json

# Web (Vite). Leave empty in development: Vite proxies /api to the API on :8080,
# so the refresh cookie stays same-origin. Set it only when the API is on another host.
VITE_API_BASE_URL=

# Mobile (Expo)
EXPO_PUBLIC_API_BASE_URL=http://localhost:8080
